# 环境变量模板：复制为 .env 后填入真实值。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交仓库；token 泄露后请到对应开放平台作废重置。

# COC 官方 API（拉取部落成员）—— https://developer.clashofclans.com
COC_API_TOKEN=

# 腾讯文档 OpenAPI（读写在线表格，access_token 约 30 天过期，需手动更新）
TENCENT_DOC_ACCESS_TOKEN=
TENCENT_DOC_CLIENT_ID=
TENCENT_DOC_OPEN_ID=

# 报名/名单在线文档 fileId
REG_DOC_FILE_ID=
ROSTER_DOC_FILE_ID=

# 可选：报名子表名。留空则由脚本按 period 自动推算为
#   "YYYYMMDD-YYYYMMDD（收集结果）"（当月首日~末日，自动处理 28/29/30/31）。
REG_SHEET=
# 可选：名单写入子表名。留空则用默认 "名单_<period>"。
ROSTER_SHEET=

# X 阵型采集与微信公众号群发（认证订阅号）
WAR_LAYOUT_SOURCE=socialdata
WAR_LAYOUT_X_AUTHORS=
WAR_LAYOUT_X_USER_IDS=
SOCIALDATA_API_KEY=
SOCIALDATA_MAX_REQUESTS_PER_RUN=7
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# true 时由 sky-scheduler 每天按北京时间群发给全部粉丝。
WAR_LAYOUT_ENABLED=false
WAR_LAYOUT_AUTO_MASS_SEND=false
WAR_LAYOUT_DAILY_TIME=09:00
# 可选：仅用于下载 pbs.twimg.com 阵型图片，不影响 SocialData、微信或其他任务。
WAR_LAYOUT_IMAGE_PROXY_URL=
