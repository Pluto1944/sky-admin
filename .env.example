# 环境变量模板：复制为 .env 后填入真实值。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交仓库；token 泄露后请到对应开放平台作废重置。

# COC 官方 API（拉取部落成员）—— https://developer.clashofclans.com
COC_API_TOKEN=

# 腾讯文档 OpenAPI（读写在线表格，access_token 约 30 天过期，需手动更新）
TENCENT_DOC_ACCESS_TOKEN=
TENCENT_DOC_CLIENT_ID=
TENCENT_DOC_OPEN_ID=

# 报名/名单在线文档 fileId
REG_DOC_FILE_ID=
ROSTER_DOC_FILE_ID=

# 可选：报名子表名。留空则由脚本按 period 自动推算为
#   "YYYYMMDD-YYYYMMDD（收集结果）"（当月首日~末日，自动处理 28/29/30/31）。
REG_SHEET=
# 可选：名单写入子表名。留空则用默认 "名单_<period>"。
ROSTER_SHEET=
